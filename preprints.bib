@unpublished{PSSY,
 author               = {Pak, Igor and Shapiro, Boris and Smirnov, Ilya and Yoshida, Ken-ichi},
 note                 = {Available at https://arxiv.org/abs/2508.17915},
 title                = {Hilbert--{K}unz multiplicity of quadrics via {E}hrhart theory},
 eprint={2508.17915},
keywords={Hilbert-Kunz},
abstract = {This note grew from Yoshida's matrix interpretation of the Han-Monsky algorithm. We express the Hilbert-Kunz multiplicity of nondegenerate quadric in terms of Ehrhart polynomials (of the unit cube and the chain and the enhanced chain polytopes of the zigzag poset). This explain the Gessel-Monsky formula for the limit Hilbert-Kunz multiplicity and further shows that for fixed dimension and varying characteristic p of the ground field,  the Hilbert-Kunz multiplicity of a quadric is a rational function on p. We also show the Hilbert-Kunz multiplicity of quadrics of fixed characteristic is a decreasing function of dimension. }
 }
 
 