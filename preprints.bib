@unpublished{SSV,
 author               = {Shapiro, Boris and Smirnov, Ilya and Vaintrob, Arkady},
 note                 = {Available at https://arxiv.org/abs/2204.11331},
 title                = {Around generalized zonotopal algebras of graphs},
 eprint={2204.11331},
abstract = {Postnikov and Shapiro showed how to each algebra one can attach a graded artinian algebra that will count spanning forests. Inspired by the work of Nenashev and Shapiro, we attach to each graph and a polynomial a filtered algebra. Thus each graph produces a constructible stratification of the space of polynomials that associates to a polynomial the sequence of the dimensions of the filtration. The main conjecture is that this stratification should distinguish graphs and we make initial steps. 
},
 }

 
